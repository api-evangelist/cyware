{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cyware Intel Exchange (CTIX) v3 Open Status Check API",
    "version": "3.6.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AccessID",
      "value": "{{AccessID}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Status Check",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Heartbeat",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{ctix_host}/ctixapi/publishing/heartbeat/"
          },
          "docs": "Returns the status of subscribers and collections indicating the health of the service."
        }
      ]
    }
  ],
  "bundled": true
}